# --- PLAYBOOK PARA INSTALAR NOTEPAD++ EN WINDOWS (ansible2) ---

cat > ~/instalar_notepad.yml << 'EOF'
---
- name: Instalar Notepad++ en Windows
  hosts: win
  tasks:
    - name: Instalar Notepad++
      win_chocolatey:
        name: notepadplusplus
        state: present
EOF

ansible-playbook ~/instalar_notepad.yml


# --- PLAYBOOK PARA INSTALAR Y ARRANCAR NGINX EN LINUX (ansible1) ---

cat > ~/instalar_nginx.yml << 'EOF'
---
- name: Instalar y arrancar NGINX en Linux
  hosts: linux
  become: yes
  tasks:
    - name: Instalar NGINX
      apt:
        name: nginx
        state: present
        update_cache: yes

    - name: Iniciar y habilitar NGINX
      service:
        name: nginx
        state: started
        enabled: yes
EOF

ansible-playbook ~/instalar_nginx.yml

# Verificar que NGINX esta corriendo en ansible1:
ansible linux -m command -a "systemctl status nginx"

