PRACTICA 2: DESPLIEGUE DE VM CON TERRAFORM EN DIGITAL OCEAN
----------------------------------------------------------------

wget -O- https://apt.releases.hashicorp.com/gpg | gpg --dearmor | sudo tee /usr/share/keyrings/hashicorp-archive-keyring.gpg > /dev/null

echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" | sudo tee /etc/apt/sources.list.d/hashicorp.list

apt update
apt install terraform -y

terraform -v

ssh-keygen -t rsa -b 4096
cat ~/.ssh/id_rsa.pub

mkdir ~/practica-terraform
cd ~/practica-terraform

# Obtener ID de llave SSH en Digital Ocean:
curl -X GET \
  -H "Authorization: Bearer TU_TOKEN_AQUI" \
  "https://api.digitalocean.com/v2/account/keys"

# Contenido del main.tf:
cat > main.tf << 'EOF'
terraform {
  required_providers {
    digitalocean = {
      source  = "digitalocean/digitalocean"
      version = "~> 2.0"
    }
  }
}

provider "digitalocean" {
  token = "TU_TOKEN_AQUI"
}

resource "digitalocean_droplet" "OS3vm" {
  image    = "ubuntu-22-04-x64"
  name     = "OS3vm"
  region   = "nyc1"
  size     = "s-1vcpu-1gb"
  ssh_keys = [ID_LLAVE_SSH]
}
EOF

terraform init

terraform plan

terraform apply

# Validar conexion SSH:
ssh root@IP-DEL-DROPLET

uname -a
hostname


